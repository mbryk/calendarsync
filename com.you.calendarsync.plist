<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.you.calendarsync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/YOURNAME/calendar-sync/calendar_sync.py</string>
    </array>

    <!-- Runs every 3 hours (10800 seconds). Change to 86400 for once a day,
         or use StartCalendarInterval instead for a fixed time of day. -->
    <key>StartInterval</key>
    <integer>10800</integer>

    <!-- Also run once immediately when the job is loaded. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/YOURNAME/calendar-sync/sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOURNAME/calendar-sync/sync.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string>
    </dict>
</dict>
</plist>
